# Copy this file to .env.local for machine-specific settings.
# .env.local is ignored by git.

# Force the app to fail fast if the PPE model is invalid.
# REQUIRE_VALID_PPE_MODEL=true

# Prefer recorded video on machines without camera access.
# AUTO_OPEN_SOURCE=recorded

# Override the default dev port if needed.
# SERVER_PORT=8000

# SQLite database path for violations and upload metadata.
# DATABASE_PATH=data/ppe_guardian.db

# Uploaded video retention window metadata.
# UPLOAD_RETENTION_DAYS=7

# Point this to a real PPE-trained model before enabling strict validation.
# PPE_MODEL_PATH=models/ppe.pt
